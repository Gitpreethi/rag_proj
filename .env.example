# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/processed/earthquake_intel.db

# LLM (Phase 16+)
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen3-8b
LLM_BASE_URL=
LLM_API_KEY=

# Embeddings (Phase 8+)
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu

# Qdrant (Phase 9+)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=india_earthquake_kb

# Retrieval
HYBRID_ALPHA=0.5
BM25_TOP_K=20
DENSE_TOP_K=20
RERANK_TOP_K=8
CHUNK_SIZE_TOKENS=550
CHUNK_OVERLAP_TOKENS=75

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# WOA-BP population model
WOA_BP_MODEL_PATH=data/processed/models/woa_bp_population.joblib
WOA_BP_TRAINING_DATA_PATH=

# Source credentials (never commit real values)
NCS_API_KEY=
NCS_USERNAME=
NCS_PASSWORD=
IMD_API_KEY=
CENSUS_API_KEY=
